{
  "name": "lovat-backend",
  "module": "src/entrypoints/server.ts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/entrypoints/server.ts",
    "start": "bun src/entrypoints/server.ts",
    "build": "bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "deploy": "sst deploy"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.159",
    "@types/bun": "latest",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.26",
    "jose": "5.2.3",
    "pg": "^8.21.0",
    "sst": "3.17.25",
    "zod": "^4.4.3"
  }
}
